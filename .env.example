# ─────────────────────────────────────────────────────────────
# 모의고사 창고 환경변수 예시. 복사해서 .env.local 로 사용하세요.
# 아무 값도 설정하지 않아도 개발 서버는 샘플 데이터 + mock 스토리지로 실행됩니다.
# ─────────────────────────────────────────────────────────────

# 사이트 절대 URL (canonical, sitemap, OpenGraph에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL 연결 문자열. 비워두면 내장 샘플 데이터(in-memory)를 사용합니다.
# 예: postgres://mogo:mogo@localhost:5432/mogo_storage
DATABASE_URL=

# 파일 스토리지 드라이버: "mock" (기본값) | "r2"
STORAGE_DRIVER=mock

# ── Cloudflare R2 (STORAGE_DRIVER=r2 일 때 필요) ──
# 공개 버킷 / 커스텀 도메인 CDN 주소 (예: https://files.example.com)
R2_PUBLIC_BASE_URL=
# 아래 값은 Signed URL 구현 시 사용합니다. (src/lib/storage/r2-storage.ts 참고)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 오류 신고 rate limit (IP당 윈도우 내 최대 요청 수 / 윈도우 ms)
REPORT_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=600000

# ── 자동 수집 (ingestion) ─────────────────────────────────────
# 로컬 개발에서 실제 공식 사이트 수집이 자동 실행되지 않도록 기본값은 false.
# true 여야 cron endpoint / ingest:scheduled / ingest:backfill 이 실제로 동작한다.
INGESTION_ENABLED=false

# source 별 비상 스위치 (true/false 가 DB 설정보다 우선, 비우면 DB 의 exam_sources.enabled 사용)
SOURCE_EBSI_ENABLED=
SOURCE_KICE_ENABLED=
SOURCE_EDUCATION_OFFICE_ENABLED=

# 영어 해설 → 단어 후보 추출 → 단어장 PDF 생성 (기본 true)
VOCABULARY_PIPELINE_ENABLED=true

# /api/cron/*, /api/internal/revalidate 인증 (Authorization: Bearer <CRON_SECRET>, 16자 이상)
# 비워두면 해당 endpoint 는 404 로 비활성화된다.
CRON_SECRET=

# ── 운영 대시보드 (/admin) ──────────────────────────────────
# 셋 다 설정해야 /admin 이 활성화된다 (하나라도 없으면 404).
ADMIN_EMAIL_ALLOWLIST=
# 24자 이상 무작위 문자열 (예: openssl rand -base64 32)
ADMIN_ACCESS_TOKEN=
# 32자 이상 무작위 문자열 (세션 쿠키 서명용)
ADMIN_SESSION_SECRET=

# ── 테스트 ─────────────────────────────────────────────────
# 설정하면 PostgreSQL 통합 테스트(fake 공식 source → DB → 사이트)가 실행된다. 별도 DB 사용 권장.
DATABASE_URL_TEST=
