# ─────────────────────────────────────────────────────────────
# 모의고사 창고 환경변수 예시. 복사해서 .env.local 로 사용하세요.
# 아무 값도 설정하지 않아도 개발 서버는 샘플 데이터 + mock 스토리지로 실행됩니다.
# ─────────────────────────────────────────────────────────────

# 사이트 절대 URL (canonical, sitemap, OpenGraph에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL 연결 문자열. 비워두면 내장 샘플 데이터(in-memory)를 사용합니다.
# 예: postgres://mogo:mogo@localhost:5432/mogo_storage
DATABASE_URL=

# 파일 스토리지 드라이버: "mock" (기본값) | "r2"
STORAGE_DRIVER=mock

# ── Cloudflare R2 (STORAGE_DRIVER=r2 일 때 필요) ──
# 공개 버킷 / 커스텀 도메인 CDN 주소 (예: https://files.example.com)
R2_PUBLIC_BASE_URL=
# 아래 값은 Signed URL 구현 시 사용합니다. (src/lib/storage/r2-storage.ts 참고)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 오류 신고 rate limit (IP당 윈도우 내 최대 요청 수 / 윈도우 ms)
REPORT_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=600000
